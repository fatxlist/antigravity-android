#!/data/user/0/com.agy/files/usr/bin/bash
# agy-notify - Post and manage Android notifications.
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
PREFIX="${PREFIX:-$(cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
HOME="${HOME:-$(dirname "$PREFIX")}"

if [ "${AGY_DISABLE_NATIVE:-0}" != "1" ]; then
    _agy_bin="${AGY_NATIVE_BIN:-}"
    if [ -z "$_agy_bin" ] && [ -x "$SCRIPT_DIR/agy" ]; then
        _agy_bin="$SCRIPT_DIR/agy"
    elif [ -z "$_agy_bin" ] && [ -x "$PREFIX/bin/agy" ]; then
        _agy_bin="$PREFIX/bin/agy"
    fi
    if [ -n "$_agy_bin" ] && [ -x "$_agy_bin" ]; then
        export PREFIX HOME
        exec "$_agy_bin" notify "$@"
    fi
    unset _agy_bin
fi

RISH_BIN="$PREFIX/bin/rish"

USAGE="Usage: agy-notify [post|cancel|list] [options]
Commands:
  post    -t <title> [-s <subtitle>] [-m <message>] [--tag <tag>] [-c|--channel <channel>] [--cascade-id <id>]
  cancel  <tag>
  list    Show active notifications
"

CMD="${1:-post}"
shift || true

TITLE="Antigravity"
SUBTITLE=""
MESSAGE=""
TAG="agy_$(date +%s)"
CHANNEL=""
CASCADE_ID=""

if [ "$CMD" = "cancel" ]; then
    if [ "$#" -ne 1 ] || [ -z "$1" ]; then
        echo "agy-notify: cancel requires exactly one tag" >&2
        echo "$USAGE" >&2
        exit 2
    fi
    TAG="$1"
    set --
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--title)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TITLE="$2"
            shift 2
            ;;
        -s|--subtitle)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            SUBTITLE="$2"
            shift 2
            ;;
        -m|--message)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            MESSAGE="$2"
            shift 2
            ;;
        --tag)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            TAG="$2"
            shift 2
            ;;
        -c|--channel)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            CHANNEL="$2"
            shift 2
            ;;
        --cascade-id)
            [ "$#" -ge 2 ] || { echo "agy-notify: missing value for $1" >&2; exit 2; }
            CASCADE_ID="$2"
            shift 2
            ;;
        *)
            if [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            fi
            shift
            ;;
    esac
done

PYTHON_BIN=""
for p in "$PREFIX/bin/python3" "$(command -v python3 2>/dev/null || true)"; do
    if [ -n "$p" ] && [ -x "$p" ]; then
        PYTHON_BIN="$p"
        break
    fi
done

gateway_notify() {
    local action="$1"
    local title="$2"
    local message="$3"
    local tag="$4"
    local channel="${5:-}"
    local cascade_id="${6:-}"
    local token_file="${AGY_GATEWAY_TOKEN_FILE:-$HOME/logs/gateway.token}"
    if [ -z "$PYTHON_BIN" ]; then
        return 1
    fi
    if [ -z "${AGY_GATEWAY_TOKEN:-}" ] && [ ! -r "$token_file" ]; then
        return 1
    fi
    HOME="$HOME" \
    PREFIX="$PREFIX" \
    AGY_NOTIFY_ACTION="$action" \
    AGY_NOTIFY_TITLE="$title" \
    AGY_NOTIFY_MESSAGE="$message" \
    AGY_NOTIFY_TAG="$tag" \
    AGY_NOTIFY_CHANNEL="$channel" \
    AGY_NOTIFY_CASCADE_ID="$cascade_id" \
    AGY_GATEWAY_TOKEN_FILE="$token_file" \
    "$PYTHON_BIN" -B - << 'PYEOF' 2>/dev/null
import json, os, urllib.request, zlib

def read_gateway_token(token_file):
    tok = (os.environ.get("AGY_GATEWAY_TOKEN") or "").strip()
    if tok:
        return tok
    try:
        with open(token_file, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""

def resolve_gateway_port(home_dir):
    env_port = (os.environ.get("AGY_GATEWAY_PORT") or "").strip()
    if env_port.isdigit():
        return int(env_port)
    port_file = os.path.join(home_dir, "logs", "gateway.port")
    try:
        with open(port_file, "r", encoding="utf-8") as f:
            raw = f.read().strip()
        if raw.isdigit():
            return int(raw)
    except OSError:
        pass
    state_file = os.path.join(home_dir, "logs", "core.state.json")
    try:
        with open(state_file, "r", encoding="utf-8") as f:
            state = json.load(f)
        gp = state.get("gateway_port")
        if isinstance(gp, int) and gp > 0:
            return gp
        if isinstance(gp, str) and gp.isdigit():
            return int(gp)
    except Exception:
        pass
    app_id = (os.environ.get("AGY_APPLICATION_ID") or os.environ.get("RISH_APPLICATION_ID") or "").strip()
    if not app_id and home_dir:
        norm = os.path.normpath(home_dir)
        if os.path.basename(norm) == "files":
            app_id = os.path.basename(os.path.dirname(norm))
    return 45161 if app_id.endswith(".dev") else 45160

home_dir = os.environ.get("HOME") or os.path.dirname(os.environ.get("PREFIX", ""))
token = read_gateway_token(os.environ["AGY_GATEWAY_TOKEN_FILE"])
if not token:
    raise SystemExit(1)

action = os.environ["AGY_NOTIFY_ACTION"]
tag = os.environ["AGY_NOTIFY_TAG"]
channel = (os.environ.get("AGY_NOTIFY_CHANNEL") or "").strip()
cascade_id = (os.environ.get("AGY_NOTIFY_CASCADE_ID") or "").strip()
stable_id = (zlib.crc32(tag.encode("utf-8")) & 0x7fffffff) or 1
payload = {
    "action": action,
    "tag": tag,
    "id": stable_id,
    "title": os.environ["AGY_NOTIFY_TITLE"],
    "message": os.environ["AGY_NOTIFY_MESSAGE"],
}
if channel:
    payload["channel"] = channel
if cascade_id:
    payload["cascade_id"] = cascade_id

envelope = {
    "command": "notify",
    "payload": payload,
}
port = resolve_gateway_port(home_dir)
req = urllib.request.Request(
    f"http://127.0.0.1:{port}/gateway",
    data=json.dumps(envelope).encode("utf-8"),
    headers={
        "Content-Type": "application/json",
        "X-Agy-Gateway-Token": token,
    },
    method="POST",
)
with urllib.request.urlopen(req, timeout=3) as resp:
    if getattr(resp, "status", 200) != 200:
        raise SystemExit(1)
    data = json.loads(resp.read().decode("utf-8", "replace") or "{}")
    if not data.get("ok"):
        raise SystemExit(1)
PYEOF
}

if [ "$CMD" = "post" ]; then
    if [ -z "$MESSAGE" ] && [ -n "$TITLE" ]; then
        MESSAGE="$TITLE"
        TITLE="Antigravity"
    fi

    BODY_TEXT="$MESSAGE"
    if [ -n "$SUBTITLE" ]; then
        BODY_TEXT="[$SUBTITLE] $MESSAGE"
    fi

    if gateway_notify "post" "$TITLE" "$BODY_TEXT" "$TAG" "$CHANNEL" "$CASCADE_ID"; then
        exit 0
    fi

    if [ -x "$RISH_BIN" ]; then
        # Optional high-resolution logo cache with safe fallback to system default icon.
        LOGO_CACHE="/data/local/tmp/agy_logo.png"
        SRC_LOGO=""
        for candidate in "${AGY_LOGO:-}" "$PREFIX/share/antigravity/logo.png" "$PREFIX/share/pixmaps/antigravity.png"; do
            if [ -n "$candidate" ] && [ -f "$candidate" ]; then
                SRC_LOGO="$candidate"
                break
            fi
        done

        LARGE_ICON_OPT=""
        if [ -n "$SRC_LOGO" ]; then
            if ! "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                "$RISH_BIN" -c "cp -f $(printf %q "$SRC_LOGO") $(printf %q "$LOGO_CACHE") && chmod 644 $(printf %q "$LOGO_CACHE")" 2>/dev/null || true
            fi
            if "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                LARGE_ICON_OPT="-I file://$LOGO_CACHE"
            fi
        fi

        "$RISH_BIN" -c "cmd notification post -S bigtext $LARGE_ICON_OPT -t $(printf %q "$TITLE") $(printf %q "$TAG") $(printf %q "$BODY_TEXT")" 2>/dev/null && exit 0
    fi

    cmd notification post -S bigtext -t "$TITLE" "$TAG" "$BODY_TEXT" 2>/dev/null && exit 0 || true
    echo "[agy-notify] notification queued: $TITLE - $MESSAGE"

elif [ "$CMD" = "cancel" ]; then
    if gateway_notify "cancel" "" "" "$TAG"; then
        exit 0
    fi
    if [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "cmd notification cancel $(printf %q "$TAG")" 2>/dev/null || true
    fi

elif [ "$CMD" = "list" ]; then
    if [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "dumpsys notification --noredact" 2>/dev/null | grep -E "pkg=|android.title=|android.text=" | head -n 40
    else
        echo "[agy-notify] rish unavailable to inspect system notification tray"
    fi

else
    echo "$USAGE"
    exit 1
fi
