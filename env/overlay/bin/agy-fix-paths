#!/data/user/0/com.agy.dev/files/usr/bin/bash
# agy-fix-paths [PATH...] -- rewrite hardcoded Android app prefixes to $PREFIX.
set -uo pipefail

_agy_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
if [ -z "${PREFIX:-}" ]; then
    PREFIX="$(cd -- "$_agy_script_dir/.." 2>/dev/null && pwd)"
fi

if [ "${AGY_DISABLE_NATIVE:-0}" != "1" ]; then
    _agy_bin="${AGY_NATIVE_BIN:-}"
    if [ -z "$_agy_bin" ] && [ -x "$_agy_script_dir/agy" ]; then
        _agy_bin="$_agy_script_dir/agy"
    elif [ -z "$_agy_bin" ] && [ -x "$PREFIX/bin/agy" ]; then
        _agy_bin="$PREFIX/bin/agy"
    fi
    if [ -n "$_agy_bin" ] && [ -x "$_agy_bin" ]; then
        export PREFIX
        exec "$_agy_bin" fix-paths "$@"
    fi
    unset _agy_bin
fi
unset _agy_script_dir
PATTERN='/data/(data|user/[0-9]+)/[^/]*/files/usr'
ENV_PATTERN='^#! */usr/bin/env[[:space:]]+(-S[[:space:]]+)?[^[:space:]]+'

if [ "$#" -gt 0 ]; then
    targets=("$@")
else
    targets=("$PREFIX")
fi

esc="$(printf '%s' "$PREFIX" | sed 's/[\\&@]/\\&/g')"
re_esc="$(printf '%s' "$PREFIX" | sed -e 's/\\/\\\\/g' -e 's/[.^$*+?(){}|[]/\\&/g' -e 's/\]/\\]/g' -e 's|/|\\/|g')"

rewrite_batch='
pattern="$1"
esc="$2"
shift 2
for f in "$@"; do
    [ -n "$f" ] || continue
    [ -L "$f" ] && continue
    [ -f "$f" ] || continue
    dir="${f%/*}"
    [ "$dir" = "$f" ] && dir="."
    tmp="$(mktemp "${dir}/.agyfix.XXXXXX" 2>/dev/null)" || continue
    if sed -E \
        -e "s@${pattern}@${esc}@g" \
        -e "1s@^#! */usr/bin/env[[:space:]]+(-S[[:space:]]+)?([^[:space:]]+)@#!${esc}/bin/\\2@" \
        -- "$f" > "$tmp" 2>/dev/null; then
        if cmp -s -- "$f" "$tmp"; then
            rm -f -- "$tmp"
        else
            chown --reference="$f" -- "$tmp" 2>/dev/null || true
            if ! chmod --reference="$f" -- "$tmp" 2>/dev/null; then
                mode="$(stat -c "%a" -- "$f" 2>/dev/null)" || mode=""
                [ -n "$mode" ] && chmod "$mode" -- "$tmp" 2>/dev/null || true
            fi
            if mv -f -- "$tmp" "$f" 2>/dev/null; then
                printf "1\n"
            else
                rm -f -- "$tmp"
            fi
        fi
    else
        rm -f -- "$tmp"
    fi
done
'

count=0
while IFS= read -r _; do
    count=$((count + 1))
done < <(
    {
        { grep -rIlZ -E -e "$PATTERN" -e "$ENV_PATTERN" -- "${targets[@]}" 2>/dev/null || true; } \
        | { xargs -0 -r grep -IHnoZ -E -e "$PATTERN" -e "$ENV_PATTERN" -- 2>/dev/null || true; } \
        | sed -E "/\x00[0-9]+:${re_esc}\$/d" \
        | while IFS= read -r -d '' f && IFS= read -r rest; do
            [ -L "$f" ] && continue
            [ -f "$f" ] || continue
            ln="${rest%%:*}"
            val="${rest#*:}"
            if [[ "$val" == '#!'* ]]; then
                [ "$ln" = "1" ] || continue
            elif [ "$val" = "$PREFIX" ]; then
                continue
            fi
            printf '%s\0' "$f"
        done \
        | sort -zu
    } | xargs -0 -r bash -c "$rewrite_batch" _ "$PATTERN" "$esc"
)

printf 'agy-fix-paths: rewrote %d file(s) -> %s\n' "$count" "$PREFIX"
