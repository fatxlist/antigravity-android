<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SplashThemeDark" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SplashThemeLight" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/splash_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
